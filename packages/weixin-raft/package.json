{
  "name": "weixin-raft",
  "version": "0.1.0",
  "description": "Route a WeChat bot to an allowlist of Raft agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "weixin-raft": "dist/main.mjs"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "weixin-agent-sdk": "workspace:*"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/config.test.ts && tsx src/raft-message.test.ts && tsx src/weixin-raft-agent.test.ts && tsx src/reply-pump.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.21.7",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
